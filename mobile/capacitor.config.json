{
  "appId": "com.mitokande.fooddeliverysim",
  "appName": "Food Delivery Simulator",
  "webDir": "www",
  "backgroundColor": "#f39a5b",
  "appendUserAgent": "FDSApp/1",
  "plugins": {
    "SystemBars": {
      "hidden": true,
      "style": "DARK"
